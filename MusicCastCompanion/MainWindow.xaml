<Window x:Class="MusicCastCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MusicCastCompanion"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="20">

            <TextBlock
                Text="MusicCast Companion"
                FontSize="24"
                Margin="0,0,0,20"/>
            <TextBlock
                Text="Receiver IP:" HorizontalAlignment="Center"/>

            <TextBox
                x:Name="IpAddressBox"
                Text=""
                Width="200"
                Margin="0,5,0,10"/>
            <Button
                Content="Connect"
                Width="150"
                Height="40"
                Margin="0,0,0,10"
                Click="Connect_Click"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock
                        Text="Zone 1" HorizontalAlignment="Center"/>
                <Button
                        Content="Power On"
                        Width="150"
                        Height="40"
                        Margin="0,0,0,10"
                        Click="PowerOn_Click"/>
                <Button
                        Content="Power Off"
                        Width="150"
                        Height="40"
                        Margin="0,0,0,10"
                        Click="PowerOff_Click"/>
            </StackPanel>
            <StackPanel Margin="20,0,0,0">
                    <TextBlock
                        Text="Zone 2" HorizontalAlignment="Center"/>
                    <Button
                        Content="Power On"
                        Width="150"
                        Height="40"
                        Margin="0,0,0,10"
                        Click="PowerOnZone2_Click"/>
                <Button
                        Content="Power Off"
                        Width="150"
                        Height="40"
                        Margin="0,0,0,10"
                        Click="PowerOffZone2_Click"/>
            </StackPanel>
        </StackPanel>
        </StackPanel>
    </Grid>
</Window>
